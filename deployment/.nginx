server {
    listen 80; 
    server_name khanhtruong.space;

    location = /favicon.ico { access_log off; log_not_found off; }
    location /static/ {
        root /home/khanh/Bug-Tracking-Django-Rest-Framework;
    }

    location / {
        include proxy_params;
        proxy_pass http://0.0.0.0:8000;
    }
}